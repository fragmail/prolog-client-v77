Процедура УстановитьРегион(сзОбъект, сзРегион)
	
	УстановитьЗначениеРеквизитаСтруктурыДанных(сзОбъект, 
		сзРегион, "base:parent");
	
КонецПроцедуры
//===========================================
Процедура СохранитьРезультатГеокодирования()
	
	Если Карта.GetGeocodeResult(0) = 1 Тогда
		
		АдреснаяИнформация = Карта.UserPointLocation;
	        
		Адрес 	= ЛокальныйАдрес(АдреснаяИнформация);
		Регион	= Регион(АдреснаяИнформация); 
		
		Широта	= Карта.UserPointCoordX;
		Долгота	= Карта.UserPointCoordY;
		
		Если стрПредставлениеРегиона = "" Тогда
			
			сзОбъектГеоданных = ОбъектГеоданных(Широта, 
				Долгота, Адрес, Регион);
			
			ВыполнитьПрямоеГеокодирование(Регион);
			
		Иначе
			
			сзРегион = ОбъектГеоданных(Широта, Долгота); 
			
			сзМассивГеоданных.ДобавитьЗначение( сзРегион, 
				стрПредставлениеРегиона);	
			
			стрПредставлениеРегиона = "";
			
			УстановитьРегион(сзОбъектГеоданных, сзРегион);
			
		КонецЕсли;	
    
	КонецЕсли;
	
КонецПроцедуры	
