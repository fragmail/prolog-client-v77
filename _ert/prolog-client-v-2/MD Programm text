Функция АдресКарты(Адрес)
    Перем Ш, В;
	
	Если (ПустоеЗначение(пАдресСервера) = 0) 
		и (ПустоеЗначение(пКлючКарты) = 0) Тогда
		
		ПолучитьАктуальныеРазмерыКарты(Ш, В);
			
		Адрес = пАдресСервера + "/?apikey="	+ пКлючКарты
			+ "&X=" + пШирота + "&Y=" + пДолгота
			+ "&W=" + (Ш - РазмерОтступа) 
			+ "&H=" + (В - РазмерОтступа);
		
		Возврат 1;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;	
	
