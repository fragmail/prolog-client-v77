//===========================================
Функция АнализАдреснойИнформации(АдреснаяИнформация)
	
	тАдреснаяИнформация = СтрЗаменить(АдреснаяИнформация, 
		".", РазделительСтрок);
		
	сАнализ = СоздатьОбъект("СписокЗначений");
	
	сАнализ.Установить("Регион",
		СтрПолучитьСтроку(тАдреснаяИнформация, 1));	
	
	сАнализ.Установить("ЛокальныйАдрес",
		СтрПолучитьСтроку(тАдреснаяИнформация, 2));
		
	Возврат сАнализ;	
	
КонецФункции	
//=========================================== 
Функция Регион(АдреснаяИнформация)
	
	стрДанныеРегиона = АнализАдреснойИнформации(АдреснаяИнформация)
		.Получить("Регион");
		
	тДанныеРегиона = СтрЗаменить(стрДанныеРегиона,
		",", РазделительСтрок);
		
	стрРезультат = "";
	Для й = 1 По СтрКоличествоСтрок(тДанныеРегиона)	Цикл
		
		стрЭлементДанных = СтрПолучитьСтроку(тДанныеРегиона, й);
		
		Если стрЭлементДанных <> "undefined" Тогда
			
			стрРезультат = стрРезультат + ?(стрРезультат = "", "", ",")
				+ стрЭлементДанных;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат стрРезультат;	
	
КонецФункции
