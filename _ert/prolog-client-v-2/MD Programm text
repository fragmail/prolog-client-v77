//===========================================
Функция ОбъектГеоданных(Широта, Долгота, Адрес = "", Регион = "")
	
	сзОбъект = СоздатьОбъект("СписокЗначений");
	
	УстановитьЗначениеРеквизитаСтруктурыДанных(сзОбъект, 
		Широта, "base:lattitude");
		
	УстановитьЗначениеРеквизитаСтруктурыДанных(сзОбъект, 
		Долгота, "base:longitude");
		
	сзОбъект.ДобавитьЗначение(Адрес,  "Адрес");	 
	
	сзОбъект.ДобавитьЗначение(Регион,"Регион");	
		
	Возврат сзОбъект;	
	
